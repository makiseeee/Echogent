# 依赖与构建产物
node_modules/
*.log
__pycache__/
*.py[cod]
download/

# AstrBot 运行数据（含密钥、数据库、日志；保留 README 占位）
astrbot/data/*
!astrbot/data/README.md

# 备份产物（保留 README 占位）
backups/*
!backups/README.md

# 个人记忆/偏好（含 QQ 号、作息等私密信息，不入公开库；保留 memory/README.md 占位）
memory/*
!memory/README.md
MEMORY.md
USER.md
RELATIONSHIP.md
personality-log.md

# 用户私密档案（含电话/邮箱，不入库）
wenbo-profile.md

# 环境变量与密钥
.env
.env.*
mcp-executor/.env

# 仅供本机所有者使用的操作手册（可能包含设备与个人工作流细节）
docs/private/
conversation-import/
scripts/private/
conversation.md
archive/private/

# MCP 执行工作区（保留说明文件）
mcp-executor/workspace/*
!mcp-executor/workspace/README.md

# 系统
.DS_Store
Thumbs.db
