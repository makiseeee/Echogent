+async def scheduled_memory_upload_retry(plugin) -> ScheduledTaskResult:
+    """Retry knowledge-base uploads that failed while the computer embedding service was offline."""
+    store = getattr(plugin, "session_memory_store", None)
+    if not store:
+        return ScheduledTaskResult(
+            task_name="MemoryUploadRetry", scope_id=None, success=True, skipped=True, reason="store unavailable"
+        )
+    succeeded, failed = await store.retry_pending_uploads()
+    logger.info(f"[Scheduler] MemoryUploadRetry succeeded={succeeded} pending={failed}")
+    return ScheduledTaskResult(
+        task_name="MemoryUploadRetry",
+        scope_id=None,
+        success=failed == 0,
+        skipped=succeeded == 0 and failed == 0,
+        reason=f"succeeded={succeeded}, pending={failed}",
+    )
+
+
