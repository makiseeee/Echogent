 class SessionMemoryStore:
     def __init__(self, plugin):
         self.plugin = plugin
+        self._pending_path = Path(plugin.data_dir) / "pending_kb_uploads.json"
+        self._pending_lock = asyncio.Lock()
+        self._retrying_pending = False
+
+    async def _queue_pending_summary(self, scope_id: str, memory: str, summary_date: str) -> None:
+        async with self._pending_lock:
+            pending = []
+            if self._pending_path.is_file():
+                try:
+                    pending = json.loads(self._pending_path.read_text(encoding="utf-8"))
+                except (OSError, json.JSONDecodeError):
+                    pending = []
+            item = {"scope_id": scope_id, "memory": memory, "summary_date": summary_date}
+            key = (scope_id, summary_date)
+            pending = [
+                entry
+                for entry in pending
+                if (entry.get("scope_id"), entry.get("summary_date")) != key
+            ]
+            pending.append(item)
+            temp_path = self._pending_path.with_suffix(".tmp")
+            temp_path.write_text(json.dumps(pending, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+            temp_path.replace(self._pending_path)
+
+    async def retry_pending_uploads(self) -> tuple[int, int]:
+        async with self._pending_lock:
+            if not self._pending_path.is_file():
+                return 0, 0
+            try:
+                pending = json.loads(self._pending_path.read_text(encoding="utf-8"))
+            except (OSError, json.JSONDecodeError):
+                return 0, 0
+
+        failed = []
+        succeeded = 0
+        self._retrying_pending = True
+        try:
+            for item in pending:
+                result = await self.save_daily_summary(
+                    str(item.get("scope_id", "")),
+                    str(item.get("memory", "")),
+                    str(item.get("summary_date", "")),
+                )
+                if "失败" in result or "不可用" in result:
+                    failed.append(item)
+                else:
+                    succeeded += 1
+        finally:
+            self._retrying_pending = False
+
+        async with self._pending_lock:
+            if failed:
+                temp_path = self._pending_path.with_suffix(".tmp")
+                temp_path.write_text(json.dumps(failed, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+                temp_path.replace(self._pending_path)
+            else:
+                self._pending_path.unlink(missing_ok=True)
+        return succeeded, len(failed)
 
