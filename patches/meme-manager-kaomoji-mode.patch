+    def _prepare_sticker(self, image_path: str) -> str:
+        """发送前压缩图片：最长边压到 max_side，GIF 保留动画，带缓存。"""
+        try:
+            from PIL import Image, ImageSequence
+
+            ext = os.path.splitext(image_path)[1].lower()
+            is_gif = ext == ".gif"
+            mtime = int(os.path.getmtime(image_path))
+            key = os.path.splitext(os.path.basename(image_path))[0]
+            cache_dir = os.path.join(self.DATA_DIR, "cache")
+            os.makedirs(cache_dir, exist_ok=True)
+            out_path = os.path.join(
+                cache_dir,
+                f"{key}_{mtime}_{self.max_side}{ext}",
+            )
+            if os.path.exists(out_path):
+                return out_path
+
+            im = Image.open(image_path)
+            if max(im.size) <= self.max_side:
+                # 小图（任一边不超过 max_side）原样发送，不重新编码
+                im.close()
+                return image_path
+            if getattr(im, "is_animated", False):
+                frames = []
+                for frame in ImageSequence.Iterator(im):
+                    frame = frame.copy()
+                    frame.thumbnail((self.max_side, self.max_side), Image.LANCZOS)
+                    frames.append(frame)
+                duration = im.info.get("duration", 80)
+                frames[0].save(
+                    out_path,
+                    save_all=True,
+                    append_images=frames[1:],
+                    loop=0,
+                    duration=duration,
+                    optimize=True,
+                )
+            else:
+                im.thumbnail((self.max_side, self.max_side), Image.LANCZOS)
+                if im.mode in ("RGBA", "P", "LA"):
+                    im.convert("RGBA").save(out_path, optimize=True)
+                else:
+                    im.convert("RGB").save(
+                        out_path,
+                        "JPEG",
+                        quality=85,
+                        optimize=True,
+                    )
+            return out_path
+        except Exception as e:  # noqa: BLE001
+            logger.warning(f"贴纸压缩失败，发送原图: {e}")
+            return image_path
+
